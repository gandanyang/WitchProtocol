; Engine configuration file.
; 它最好保持由 Godot 编辑器管理；如需手改请参照 ReturnToStars 的
; 「四字段铁律」思路：任何结构性改动都先读 docs/AI_GUARDRAIL.md。

config_version=5

[application]

config/name="Witch Protocol · 魔女协议"
config/description="魔女协议 — 二次元弹幕 RPG（记忆被剥夺时，还剩什么）"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/main_scene="res://scenes/Main.tscn"
config/icon="res://icon.svg"
; 使用自定义用户目录名（纯 ASCII，避开项目名里的「·」/空格）
; 沙箱/日志写 user:// 时权限更稳，SaveSystem 存档路径也变短
config/use_custom_user_dir=true
config/custom_user_dir_name="magicThunder"

[autoload]

GameManager="*res://scripts/autoload/GameManager.cs"
EventBus="*res://scripts/autoload/EventBus.cs"
SaveSystem="*res://scripts/autoload/SaveSystem.cs"
DevTestHub="*res://scripts/autoload/DevTestHub.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="magicThunder"

